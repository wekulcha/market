# Domains
MARKET_API_DOMAIN=apimarket.wekulcha.ru
MARKET_USER_DOMAIN=market.wekulcha.ru
MARKET_ADMIN_DOMAIN=adminmarket.wekulcha.online
MARKET_SUPERADMIN_DOMAIN=supadmin.wekulcha.online
MARKET_PUBLIC_API_URL=https://apimarket.wekulcha.ru/api/v1
MARKET_ACME_EMAIL=wekulcha@gmail.com

# Gateway ports. These defaults avoid conflicts with the existing Kulcha gateway.
# For public HTTPS on the domains, use one shared reverse proxy for all domains,
# or set 80/443 only when this compose owns the public ports.
MARKET_GATEWAY_HTTP_PORT=18080
MARKET_GATEWAY_HTTPS_PORT=18443

# Backend CORS (comma-separated)
MARKET_CORS_ALLOWED_ORIGINS=https://market.wekulcha.ru,https://adminmarket.wekulcha.online,https://supadmin.wekulcha.online,https://app.wekulcha.ru
MARKET_CORS_ADDITIONAL_ORIGINS=

# Database
MARKET_POSTGRES_DB=kulcha_market
MARKET_POSTGRES_USER=kulcha_market
MARKET_POSTGRES_PASSWORD=change-me

# Bots
MARKET_USER_BOT_TOKEN=
MARKET_ADMIN_BOT_TOKEN=
MARKET_SUPERADMIN_BOT_TOKEN=
MARKET_SUPERADMIN_ALLOWED_IDS=
MARKET_USER_MINI_APP_VERSION=20260608-1

# Shared Kulcha support bot link used by Market bots.
MARKET_SUPPORT_LINK=https://t.me/wekulcha_sup_bot

# Optional Telegram HTTP proxy for bots and backend notifications. Set this on VPS if Telegram API is not reachable directly.
MARKET_TELEGRAM_PROXY_URL=

# User Mini App auth
MARKET_AUTH_ACCESS_SECRET=change-me-long-random-secret
MARKET_AUTH_ACCESS_TTL_MINUTES=15
MARKET_AUTH_REFRESH_TTL_DAYS=30
# Production: .wekulcha.ru. Localhost/non-wekulcha tunnel: leave explicitly empty.
MARKET_AUTH_COOKIE_DOMAIN=.wekulcha.ru
# Keep true for every HTTPS tunnel/production deployment; false only for plain HTTP localhost.
MARKET_AUTH_COOKIE_SECURE=true

# Yandex Object Storage
MARKET_OBJECT_STORAGE_ENDPOINT=https://storage.yandexcloud.net
MARKET_OBJECT_STORAGE_REGION=ru-central1
MARKET_OBJECT_STORAGE_BUCKET=kulcha-market-menu-items
MARKET_OBJECT_STORAGE_ACCESS_KEY_ID=
MARKET_OBJECT_STORAGE_SECRET_ACCESS_KEY=
MARKET_OBJECT_STORAGE_PUBLIC_BASE_URL=https://kulcha-market-menu-items.storage.yandexcloud.net

# API secrets for internal services
MARKET_INTERNAL_API_SECRET=change-me-market-internal-secret
MARKET_BOT_API_SECRET=change-me-market-bot-secret

# KULCHA B2B product contour
APP_NAME=KULCHA B2B
APP_ENV=development
B2B_DOMAIN=app.wekulcha.ru
PUBLIC_BASE_URL=https://app.wekulcha.ru
BUYER_APP_PATH=/buyer
SELLER_APP_PATH=/seller
ADMIN_APP_PATH=/admin
B2B_PUBLIC_API_URL=/api
B2B_ASSET_BASE_URL=/b2b-static/

# B2B Telegram bots. Never commit real values.
BUYER_BOT_TOKEN=
BUYER_BOT_USERNAME=
BUYER_BOT_MODE=polling
SELLER_BOT_TOKEN=
SELLER_BOT_USERNAME=
SELLER_BOT_MODE=polling
ADMIN_BOT_TOKEN=
ADMIN_BOT_USERNAME=
ADMIN_BOT_MODE=polling
# Required for b2b_admin_bot. Empty means fail closed.
ADMIN_TELEGRAM_IDS=
BUYER_BOT_WEBHOOK_SECRET=
SELLER_BOT_WEBHOOK_SECRET=
ADMIN_BOT_WEBHOOK_SECRET=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
B2B_INTERNAL_API_SECRET=
B2B_SUPPORT_URL=
B2B_TELEGRAM_PROXY_URL=
B2B_BOT_REQUEST_TIMEOUT_SECONDS=15

# Local bootstrap. The seed script refuses non-local databases by default.
B2B_BOOTSTRAP_SUPERADMIN_TELEGRAM_ID=

# Subscription and ordering policy
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=
SUBSCRIPTION_GRACE_PERIOD_DAYS=0
CATALOG_ACCESS_POLICY=TEASER
RESERVATION_TTL_MINUTES=30
DEFAULT_CURRENCY=RUB
APP_TIMEZONE=Europe/Moscow
ORDER_PAYMENT_METHOD=PAY_ON_DELIVERY
DELIVERY_PROVIDER=manual

# Durable PostgreSQL notification outbox worker
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_POLL_SECONDS=5

# Telegram update dedup for all webhook bots, plus buyer FSM. The local Compose
# default is its private Redis service. Use authenticated/TLS managed Redis in production.
REDIS_URL=redis://redis:6379/0

# B2B image adapter reuses the backend's MARKET_ configuration convention.
MARKET_OBJECT_STORAGE_PROVIDER=local
MARKET_UPLOADS_DIR=/app/uploads
MARKET_OFFER_MAX_IMAGES=8
MARKET_OFFER_IMAGE_MAX_BYTES=10485760
